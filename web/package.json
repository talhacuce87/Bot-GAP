{
  "name": "gap-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bake:chibi": "node scripts/bake-chibi.mjs",
    "lod:chibi": "node scripts/lod-chibi.mjs"
  },
  "dependencies": {
    "node-datachannel": "0.33.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@discord/embedded-app-sdk": "^2.4.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "hls.js": "^1.7.3",
    "meshoptimizer": "^1.1.1",
    "three": "^0.186.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
