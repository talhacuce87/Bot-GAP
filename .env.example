DISCORD_TOKEN=token
BOT_PREFIX=!

# ---------------------------------------------------------------------------
# AI sohbet & hafıza eklentisi (isteğe bağlı). false iken bot eskisi gibi çalışır.
# ---------------------------------------------------------------------------
AI_ENABLED=false

# --- Google AI Studio (Gemini API) — İSTEĞE BAĞLI, ÜCRETLİ OLABİLİR ---
# Faturalandırması açık bir projenin anahtarıysa her istek ücretlendirilir.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.8-flash
# Virgülle ayrılmış Google yedek modelleri (aynı anahtar), örn: gemini-2.5-flash-lite
GOOGLE_AI_FALLBACK_MODEL=
# Sert günlük sınırlar (UTC gün): biri dolunca Google atlanır, OpenRouter'a geçilir.
GOOGLE_AI_DAILY_REQUEST_BUDGET=1000
GOOGLE_AI_DAILY_COST_LIMIT_USD=5
# Maliyet tahmini için birim fiyat (USD / 1M token). gemini-3.8-flash: 0.75 / 3.75 (2027'den itibaren 1.50 / 7.50)
GOOGLE_AI_PRICE_INPUT_PER_M=0.75
GOOGLE_AI_PRICE_OUTPUT_PER_M=3.75
GOOGLE_AI_MAX_OUTPUT_TOKENS=800
# auto: Gemini 2.5 → düşünme kapalı, Gemini 3+ → minimal (kapatılamaz), Gemma → gönderilmez
GOOGLE_AI_REASONING_EFFORT=auto
# Sağlayıcı sırası
AI_PROVIDER_ORDER=google,openrouter

# --- OpenRouter (ücretsiz modeller) ---
OPENROUTER_API_KEY=
# Akıl yürütmesi varsayılan kapalı, Türkçesi iyi ücretsiz model. openrouter/free her istekte
# rastgele bir model seçer; bazıları düşünme metnini cevaba sızdırabilir.
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Virgülle ayrılmış yedek modeller, sırayla denenir; yalnızca ücretsiz olduğu doğrulananlar kullanılır.
# Gemma'nın sağlayıcısı (Google AI Studio) yoğunken 429 verir; Nemotron farklı sağlayıcıda (Nvidia) çalışır.
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free,openrouter/free
# none (önerilen): akıl yürütme kapalı • low/medium/high: açık ama cevaptan gizli
AI_REASONING_EFFORT=none
# true yapılmadıkça ücretli/doğrulanamayan modeller asla kullanılmaz.
AI_ALLOW_PAID_MODELS=false

AI_MAX_OUTPUT_TOKENS=350
AI_CONTEXT_TOKEN_BUDGET=3000
AI_MAX_CONCURRENT_REQUESTS=1
AI_MAX_QUEUE_SIZE=4
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2

# mention: etiket/yanıt/!ai ile cevap verir • command: sadece !ai
AI_RESPONSE_MODE=mention

AI_MEMORY_ENABLED=true
# false: kanallar yalnızca !aiayar kanal ekle ile indekslenir (önerilen)
AI_INDEXING_DEFAULT=false
AI_MESSAGE_RETENTION_DAYS=30

# OpenRouter yerel bütçesi (UTC gün). OpenRouter ücretsiz kotası 50/gün (10$+ kredi ile 1000/gün) — altında tut.
AI_DAILY_REQUEST_BUDGET=35
# Kişi başı günlük istek (tüm sağlayıcılar toplamı)
AI_USER_DAILY_REQUEST_LIMIT=10
AI_CHANNEL_COOLDOWN_SECONDS=15
AI_USER_COOLDOWN_SECONDS=30

# Slash komutlarını açılışta Discord'a kaydet (prefix komutları her durumda çalışır)
AI_SLASH_SYNC=false
